# Skopíruj na ".env" a vyplň podľa firemného servera.
# Server čaká na tieto premenné pri štarte (src/config.js) — bez nich sa nespustí.

# --- Pripojenie na SQL Server -------------------------------------------
# Hostname/IP servera so SQL Serverom (ak beží na tom istom stroji ako
# backend, stačí "localhost"; ak je na inom stroji v sieti, dajte jeho
# meno/IP — to potvrdí IT, pozri sql-server-schema.sql).
DB_SERVER=localhost
# Pomenovaná inštancia (nepovinné) — nechajte prázdne, ak sa nepoužíva.
DB_INSTANCE=
DB_PORT=1433
DB_NAME=HodnotenieDefektov
# SQL Server Authentication (meno/heslo) — jednoduchšie nasadenie ako
# Windows Authentication, nevyžaduje natívne ovládače. Ak firma trvá na
# Windows Authentication (integrated), treba doplniť balík msnodesqlv8 a
# upraviť src/db.js (viď komentár tam).
DB_USER=
DB_PASSWORD=
# true, ak SQL Server vyžaduje šifrované spojenie (odporúčané); na starších
# on-prem inštaláciách bez certifikátu môže byť potrebné false.
DB_ENCRYPT=true
# true len pri testovaní so self-signed certifikátom na internej sieti —
# v produkcii nechajte false.
DB_TRUST_SERVER_CERTIFICATE=false

# --- Server --------------------------------------------------------------
PORT=4000

# Povolené pôvodné adresy (origin) appky, oddelené čiarkou — appka dnes beží
# na GitHub Pages (verejná adresa), ale keďže backend je len na vnútornej
# sieti, appku bude asi treba servovať tiež odtiaľto (pozri backend/README.md)
# — v tom prípade sem daj adresu, odkiaľ sa appka naozaj servuje.
CORS_ORIGIN=https://rogan9312.github.io

# --- Jednoduchá spoločná autentifikácia API (nepovinné, ale odporúčané) --
# Ak sa nastaví, appka musí posielať rovnakú hodnotu v hlavičke
# "X-API-Key" ku každému požiadavku. Rovnaký princíp ako zdieľaný PIN
# appky pre Administráciu — jeden spoločný tajný kľúč, nie účty naviac.
# Ak sa nechá prázdne, kontrola sa (zámerne, pre lokálny vývoj) vynechá.
API_KEY=
